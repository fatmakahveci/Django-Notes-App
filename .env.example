# Local development settings. No real credentials belong in this file.
# Django does not load .env files automatically; export these values in your
# shell or configure them in Docker Compose's environment section.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: an absolute SQLite path. The default is src/db.sqlite3.
# DJANGO_DATABASE_PATH=/absolute/path/to/db.sqlite3

# Required when DJANGO_DEBUG=false. Generate a unique private value and store
# it outside version control. HTTPS and secure cookies are enabled in that mode.
# DJANGO_SECRET_KEY=

# Production Compose additionally reads DOMAIN from .env.production.
# See docs/deployment.md. Never enable proxy trust on a public app port.
# DJANGO_TRUST_PROXY_HEADERS=false
